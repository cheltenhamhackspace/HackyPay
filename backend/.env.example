# SumUp API Configuration
SUMUP_API_TOKEN=sup_sk_your_api_token_here
SUMUP_MERCHANT_CODE=your_merchant_code_here
SUMUP_READER_ID=rdr_your_reader_id_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# CORS Configuration (only needed if the frontend is served from a different origin;
# the kiosk UI is served by the backend itself, same-origin)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: shared admin token required by POST /api/config/reload.
# When set, callers must send header X-Admin-Token: <value>.
# When unset, reload is allowed only from loopback connections.
# ADMIN_TOKEN=change-me-to-a-long-random-string
