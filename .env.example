# HackyPay configuration. Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# Create an API key at https://developer.sumup.com/ and find the merchant
# code and reader ID in your SumUp dashboard.
#
# Validation rules (enforced at startup, see backend/app/config.py):
#   SUMUP_API_TOKEN      starts with "sup_sk_", length >= 20
#   SUMUP_MERCHANT_CODE  length >= 5
#   SUMUP_READER_ID      starts with "rdr_"
SUMUP_API_TOKEN=
SUMUP_MERCHANT_CODE=
SUMUP_READER_ID=

# ---- Optional ----

# Host port for the kiosk UI and API (default: 8000)
#HACKYPAY_PORT=8000

# Enables POST /api/config/reload (send it as the X-API-Key header).
# Leave unset to keep the reload endpoint disabled.
#ADMIN_TOKEN=

# Only needed if you serve the UI from a different origin than the API.
#ALLOWED_ORIGINS=http://localhost:3000

# Verbose debug logging — keep off in production.
#DEBUG=false
